{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: prepare",
      "program": "${workspaceFolder}/src/api/bin/Debug/net10.0/GmailOrganiser.Api.dll",
      "cwd": "${workspaceFolder}/src/api",
      "launchSettingsProfile": "GmailOrganiser.Api",
      "launchSettingsFilePath": "${workspaceFolder}/src/api/Properties/launchSettings.json",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Web: ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/src/web"
    }
  ],
  "compounds": [
    {
      "name": "API + Web",
      "configurations": [".NET: API", "Web: ng serve"],
      "stopAll": true
    }
  ]
}
