{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/GmailOrganiser.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "path": "src/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeBegins": true,
          "beginsPattern": { "regexp": "Changes detected|Building\\.\\.\\." },
          "endsPattern": { "regexp": "bundle generation (complete|failed)|Watch mode enabled" }
        }
      }
    }
  ]
}
