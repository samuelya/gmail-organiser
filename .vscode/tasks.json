{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-db",
      "detail": "Starts the dev Postgres on 127.0.0.1:5432 and waits until it is healthy.",
      "type": "process",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.yml", "-f", "docker-compose.dev.yml", "up", "-d", "--wait", "db"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "api: prepare",
      "dependsOn": ["start-db", "build-api"],
      "problemMatcher": []
    },
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/GmailOrganiser.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "path": "src/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeBegins": true,
          "beginsPattern": { "regexp": "Changes detected|Building\\.\\.\\." },
          "endsPattern": { "regexp": "bundle generation (complete|failed)|Watch mode enabled" }
        }
      }
    }
  ]
}
