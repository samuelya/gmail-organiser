# Copy to .env and adjust. .env is git-ignored; never commit it.
# Every value here is a safe placeholder or a development-only default.

# --- Ports (always bound to 127.0.0.1) ---
# Port of the web UI: http://localhost:5180
WEB_PORT=5180
# Port the dev override (docker-compose.dev.yml) publishes Postgres on, for the IDE-run API.
DB_PORT=5432

# --- Database (development-only throwaway credentials; change them for real use) ---
POSTGRES_USER=gmo
POSTGRES_PASSWORD=gmo_dev_password
POSTGRES_DB=gmail_organiser
# Not needed with compose (the api service builds it from the POSTGRES_* values above).
# The IDE-run API reads it from appsettings.Development.json; override it in the environment if needed:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=gmail_organiser;Username=gmo;Password=gmo_dev_password

# --- Ollama (runs on the host) ---
# First-run default for the Settings page. On Linux, Ollama must listen on 0.0.0.0 (OLLAMA_HOST).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Google OAuth client (your own Google Cloud project) ---
# Leave empty to enter them in the Setup wizard; a value here locks both fields in the UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the web UI (keep the port equal to WEB_PORT; compose defaults it to http://localhost:${WEB_PORT}).
# The OAuth redirect URI is {APP_BASE_URL}/api/auth/google/callback. Register both in your Google OAuth client:
#   http://localhost:5180/api/auth/google/callback  (compose, WEB_PORT)
#   http://localhost:4200/api/auth/google/callback  (IDE run with ng serve)
APP_BASE_URL=http://localhost:5180

# --- Development ---
# true: in-memory fake Gmail mailbox and token store (synthetic example.com data, no Google).
GMAIL_FAKE=false
