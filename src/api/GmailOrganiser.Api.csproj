<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>GmailOrganiser</RootNamespace>
    <AssemblyName>GmailOrganiser.Api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- DocumentFormat.OpenXml: MIT. docx, xlsx and pptx attachment converters. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.75.0.4225" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Analysis/Prompts/analysis-v4.md" LogicalName="GmailOrganiser.Analysis.Prompts.analysis-v4.md" />
    <EmbeddedResource Include="Analysis/Attachments/image-vision-v1.md" LogicalName="GmailOrganiser.Analysis.Attachments.image-vision-v1.md" />
    <EmbeddedResource Include="Mcp/Prompts/review-pending.md" LogicalName="GmailOrganiser.Mcp.Prompts.review-pending.md" />
    <EmbeddedResource Include="Mcp/Prompts/review-label-plan.md" LogicalName="GmailOrganiser.Mcp.Prompts.review-label-plan.md" />
    <EmbeddedResource Include="Rules/Prompts/rules-summary-v1.md" LogicalName="GmailOrganiser.Rules.Prompts.rules-summary-v1.md" />
  </ItemGroup>
</Project>
