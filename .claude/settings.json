{
  "permissions": {
    "allow": [
      "Bash(scripts/gh/issue-context.sh:*)",
      "Bash(scripts/gh/pr-context.sh:*)",
      "Bash(scripts/gh/wait-ci.sh:*)",
      "Bash(scripts/gh/set-status.sh:*)",
      "Bash(scripts/gh/link-sub-issue.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.claude/private-terms.txt)"
    ]
  },
  "model": "claude-opus-5-5",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "25"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lead-fresh.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
